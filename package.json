{
  "name": "my-slow-news",
  "version": "0.1.0",
  "description": "Deliberate news consumption - daily digests with knowledge extraction",
  "type": "module",
  "scripts": {
    "digest": "bun run src/cli/digest.ts",
    "stance": "bun run src/cli/stance.ts",
    "query": "bun run src/cli/explorer/index.tsx",
    "query:legacy": "bun run src/cli/query.ts",
    "predicates": "bun run src/cli/predicates.ts",
    "embeddings": "bun run src/cli/embeddings.ts",
    "embeddings:backfill": "bun run src/cli/embeddings.ts backfill",
    "embeddings:detect": "bun run src/cli/embeddings.ts detect",
    "embeddings:stats": "bun run src/cli/embeddings.ts stats",
    "contradictions": "bun run src/cli/contradictions.ts",
    "contradictions:detect": "bun run src/cli/contradictions.ts detect",
    "contradictions:stats": "bun run src/cli/contradictions.ts stats",
    "contradictions:list": "bun run src/cli/contradictions.ts list",
    "db:init": "bun run src/db/init.ts",
    "dev": "bun run --watch src/index.ts",
    "test": "bun test",
    "test:ci": "bun test --ci",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mastra/core": "^0.24.9",
    "commander": "^13.0.0",
    "ink": "^5.2.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "linkedom": "^0.18.0",
    "react": "^18.3.1",
    "rss-parser": "^3.13.0",
    "surrealdb": "^1.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.27",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
