{
  "name": "my-slow-news",
  "version": "0.1.0",
  "description": "Deliberate news consumption - daily digests with knowledge extraction",
  "type": "module",
  "scripts": {
    "digest": "bun run src/cli/digest.ts",
    "stance": "bun run src/cli/stance.ts",
    "query": "bun run src/cli/query.ts",
    "predicates": "bun run src/cli/predicates.ts",
    "db:init": "bun run src/db/init.ts",
    "dev": "bun run --watch src/index.ts",
    "test": "bun test",
    "test:ci": "bun test --ci",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mastra/core": "^0.24.9",
    "commander": "^13.0.0",
    "linkedom": "^0.18.0",
    "rss-parser": "^3.13.0",
    "surrealdb": "^1.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
