    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.27",
    "@vitest/ui": "^2.1.8",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.2",
