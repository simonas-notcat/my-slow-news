{
  "name": "my-slow-news",
  "version": "0.1.0",
  "description": "Deliberate news consumption - daily digests with knowledge extraction",
  "type": "module",
  "scripts": {
    "digest": "tsx src/cli/digest.ts",
    "stance": "tsx src/cli/stance.ts",
    "query": "tsx src/cli/explorer/index.tsx",
    "query:legacy": "tsx src/cli/query.ts",
    "predicates": "tsx src/cli/predicates.ts",
    "embeddings": "tsx src/cli/embeddings.ts",
    "embeddings:backfill": "tsx src/cli/embeddings.ts backfill",
    "embeddings:detect": "tsx src/cli/embeddings.ts detect",
    "embeddings:stats": "tsx src/cli/embeddings.ts stats",
    "contradictions": "tsx src/cli/contradictions.ts",
    "contradictions:detect": "tsx src/cli/contradictions.ts detect",
    "contradictions:stats": "tsx src/cli/contradictions.ts stats",
    "contradictions:list": "tsx src/cli/contradictions.ts list",
    "themes": "tsx src/cli/themes.ts",
    "themes:cluster": "tsx src/cli/themes.ts cluster",
    "themes:list": "tsx src/cli/themes.ts list",
    "themes:stats": "tsx src/cli/themes.ts stats",
    "db:init": "tsx src/db/init.ts",
    "dev": "tsx watch src/index.ts",
